# -- Frontend (Vite) -----------------------------------------------------------
# VITE_API_BASE_URL is set to /api in netlify.toml for production; override locally if needed.
VITE_API_BASE_URL=/api

# -- Backend (Netlify Function / local server) ---------------------------------

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT signing secret (required, long random string)
JWT_SECRET=replace-this-with-a-private-random-secret-of-at-least-32-characters

# Live/public app origin (required in production for CORS and PayFast return/notify/cancel URLs)
APP_ORIGIN=https://www.princemath.co.za

# PayFast (required for subscriptions/payments)
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
# Set to true only for sandbox testing; use false for live payments.
PAYFAST_SANDBOX=false

# Password-reset email (required for password reset delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Download limits (optional; defaults shown)
DOWNLOAD_LIMIT_PER_DAY=5
DOWNLOAD_LIMIT_PER_LESSON=3

# AI study assistant (optional, OpenAI-compatible chat completions API)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Set in private local/deployment environment only; never commit a real key.
AI_API_KEY=
