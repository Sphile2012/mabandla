# -- Frontend (Vite) -----------------------------------------------------------
VITE_API_BASE_URL=/api

# -- Backend (Netlify Function / local server) ---------------------------------

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT secret
JWT_SECRET=replace-this-with-a-private-random-secret-of-at-least-32-characters

# PayFast credentials
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=false

# AI study assistant (OpenAI-compatible chat completions API)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Set AI_API_KEY in your private local/deployment environment; never commit the real key.
AI_API_KEY=

# Password-reset emails (use a Gmail app password or another SMTP provider).
# Required for reset requests; the API returns an error rather than logging codes if unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Download limits
DOWNLOAD_LIMIT_PER_DAY=5
DOWNLOAD_LIMIT_PER_LESSON=3

# Your deployed app origin
APP_ORIGIN=https://mabandla.netlify.app

# Assign administrator access by setting the account's role to "admin" in Supabase.
