# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# URL of the backend API (leave as /api for Netlify, or http://localhost:3001 for local dev)
VITE_API_BASE_URL=/api

# ── Backend (Netlify Function / local server) ─────────────────────────────────

# Supabase — get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# PayFast credentials
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=false

# Your deployed app origin (used for PayFast return/cancel/notify URLs)
APP_ORIGIN=https://your-app-url.netlify.app

# Admin email (for admin panel access)
ADMIN_EMAIL=poomeigh503@gmail.com

# Android APK download URL (optional)
APK_DOWNLOAD_URL=https://github.com/Sphile2012/math-mastery-hub-copy/releases/latest/download/MathTutor.apk

# ── Email / SMTP (for OTP, password reset, email verification) ────────────────
# Leave blank to disable email sending (OTPs will be logged to the function console instead).
# Works with any SMTP provider: Gmail, SendGrid, Mailgun, Brevo, etc.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   (use an App Password, not your account password)
#   SMTP_FROM=Prince Math Academy <you@gmail.com>
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=your-sendgrid-api-key
#   SMTP_FROM=noreply@princemath.co.za
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
