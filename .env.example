# â”€â”€ Frontend (Vite) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# URL of the backend API (leave as /api for Netlify, or http://localhost:3001 for local dev)
VITE_API_BASE_URL=/api

# â”€â”€ Backend (Netlify Function / local server) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Supabase â€” get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT secret â€” use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# PayFast credentials
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=false

# Your deployed app origin (used for PayFast return/cancel/notify URLs)
APP_ORIGIN=https://your-app-url.netlify.app

# Admin email (for admin panel access)
ADMIN_EMAIL=your-admin-email@example.com

# Android APK download URL (optional)
APK_DOWNLOAD_URL=https://your-apk-download-url.com/app.apk

# â”€â”€ Email (for OTP, password reset, email verification) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# OPTION 1 (Recommended): Resend â€” free tier, no domain setup needed
# Sign up at https://resend.com, get your API key, add it here
RESEND_API_KEY=re_your_resend_api_key_here
# Optional: sender address (must be verified in Resend dashboard)
RESEND_FROM=Your Name <noreply@yourdomain.com>

# OPTION 2: SMTP (Gmail, SendGrid, Mailgun, etc.)
# Leave blank if using Resend above
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

